rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'clodas12345@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      ); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Validation Helpers
    function isValidGame(data) {
      return data.keys().hasAll(['poolId', 'numbers']) &&
             data.poolId is string &&
             data.numbers is list &&
             (!data.keys().contains('numbersKey') || data.numbersKey is string) &&
             (!data.keys().contains('contestNumber') || data.contestNumber is number || data.contestNumber == null);
    }

    // Rules
    match /users/{uid} {
      allow read: if true;
      allow write: if true;
    }

    match /members/{memberId} {
      allow read: if true;
      allow write: if true;
    }

    match /pools/{poolId} {
      allow read: if true;
      allow write: if true;
    }

    match /games/{gameId} {
      allow read, write: if true;
    }

    match /payments/{paymentId} {
      allow read: if true;
      allow write: if true;
    }

    match /messages/{msgId} {
      allow read, write: if true;
    }

    match /polls/{pollId} {
      allow read: if true;
      allow write: if true;
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    match /notifications/{notifId} {
      allow read: if true;
      allow write: if true;
    }

    match /lotofacil_results/{resId} {
      allow read: if true;
      allow write: if true;
    }

    match /megasena_results/{resId} {
      allow read: if true;
      allow write: if true;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
