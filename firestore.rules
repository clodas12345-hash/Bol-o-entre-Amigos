rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'clodas12345@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        (exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isApprovedUser() {
      return isSignedIn() && (
        request.auth.token.email == 'clodas12345@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true) ||
        (exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/members/$(request.auth.uid)).data.approved == true) ||
        isAdmin()
      );
    }

    // Users & Members (supports both Google Auth and Phone Login sessions)
    match /users/{uid} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin() || request.auth == null;
    }

    match /members/{memberId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin() || request.auth == null;
    }

    // Pools & Games
    match /pools/{poolId} {
      allow read, write: if true;
    }

    match /games/{gameId} {
      allow read, write: if true;
    }

    // Payments & Receipts & Monthly Snapshots
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    match /pending_receipts/{receiptId} {
      allow read, write: if true;
    }

    match /approved_receipts/{receiptId} {
      allow read, write: if true;
    }

    match /monthly_snapshots/{monthId} {
      allow read, write: if true;
    }

    // Communication & Polls & Events & Notifications
    match /messages/{msgId} {
      allow read, write: if true;
    }

    match /polls/{pollId} {
      allow read, write: if true;
    }

    match /events/{eventId} {
      allow read, write: if true;
    }

    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // Official Lottery Results (synced by server.ts and client)
    match /lotofacil_results/{resId} {
      allow read, write: if true;
    }

    match /megasena_results/{resId} {
      allow read, write: if true;
    }

    // System Config, Settings, Backups, AI Learnings & Error Logs
    match /settings/{settingId} {
      allow read, write: if true;
    }

    match /system_config/{configId} {
      allow read, write: if true;
    }

    match /bet_releases/{releaseId} {
      allow read, write: if true;
    }

    match /bet_submissions/{submissionId} {
      allow read, write: if true;
    }

    match /ai_learnings/{learningId} {
      allow read, write: if true;
    }

    match /system_errors/{errorId} {
      allow read, write: if true;
    }

    match /backups_history/{backupId} {
      allow read, write: if true;
    }
  }
}
